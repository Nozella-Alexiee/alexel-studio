{
  "name": "alexel-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Alexel Studio — free, open source code editor with a real terminal, language servers and Claude Code built in",
  "author": "Alexel",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/electron/dev.mjs",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build && node scripts/electron/build.mjs",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "postinstall": "node -e \"try{for(const d of ['darwin-arm64','darwin-x64']){require('fs').chmodSync('node_modules/node-pty/prebuilds/'+d+'/spawn-helper',0o755)}}catch{}\""
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "bundled-typescript": "npm:typescript@^5.9.3",
    "node-pty": "^1.1.0",
    "typescript-language-server": "^6.0.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "ignore": "^7.0.12",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "node-pty@1.1.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "dev.alexel.studio",
    "productName": "Alexel Studio",
    "copyright": "© Alexel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@parcel/**",
      "node_modules/typescript-language-server/**",
      "node_modules/bundled-typescript/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Alexel Studio"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": [
          "ts",
          "tsx",
          "js",
          "jsx",
          "json",
          "md",
          "py",
          "rs",
          "php",
          "go",
          "html",
          "css",
          "txt"
        ],
        "role": "Editor"
      }
    ],
    "electronLanguages": [
      "en",
      "id"
    ],
    "artifactName": "Alexel-Studio-${os}-${arch}.${ext}"
  }
}
